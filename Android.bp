/*
 * AutoPilot — 车载智能终端核心服务
 *
 * 功能：
 * 1. 开机自动启动 WiFi 热点（基于 TetheringManager）
 * 2. 双卡信号智能切换（基于 SubscriptionManager + TelephonyCallback）
 *
 * 作为特权系统应用安装到 /system_ext/priv-app/，
 * 使用 platform 签名以获得系统级权限。
 */
android_app {
    name: "AutoPilot",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    manifest: "AndroidManifest.xml",

    // 使用 platform 签名，获得系统级权限
    platform_apis: true,
    certificate: "platform",

    // 安装到 system_ext 分区的 priv-app 目录
    system_ext_specific: true,
    privileged: true,

    // 替换开机向导 + 车载场景不需要的应用
    // overrides 机制：构建系统遇到 overrides 中的模块名时，不安装该模块，改为安装 AutoPilot
    // 保留：Dialer（电话）、messaging（短信）、Contacts（联系人）、Camera2/Aperture（相机）、
    //       Settings、Launcher3QuickStep、SystemUI、蓝牙/WiFi/GPS 相关
    overrides: [
        // 开机向导（AutoPilot 内置 ProvisionActivity 替代）
        "LineageSetupWizard",
        "Provision",

        // 浏览器
        "Browser2",
        "Jelly",

        // 日历
        "Etar",

        // 计算器
        "ExactCalculator",

        // 时钟/闹钟
        "DeskClock",

        // 音乐播放器（保留音频 HAL，仅删 UI 应用）
        "Music",
        "Twelve",

        // 邮件
        "Camelot",

        // 录音机
        "Recorder",

        // 相册/图库（保留相机 app，仅删图库浏览器）
        "Gallery2",
        "Glimpse",

        // 文件管理器
        "DocumentsUI",

        // 壁纸/主题
        "WallpaperPicker2",
        "ThemePicker",
        "Backgrounds",

        // 音效均衡器
        "AudioFX",
        "MusicFX",

        // 头像选择器
        "AvatarPicker",

        // 备份
        "Seedvault",

        // 系统更新器（车载不需要 OTA）
        "Updater",

        // FM 收音机
        "FMRadio",

        // 彩蛋
        "EasterEgg",

        // 打印服务
        "BuiltInPrintService",
        "PrintSpooler",
        "PrintRecommendationService",

        // 其他非必要
        "QuickSearchBox",
        "BookmarkProvider",
    ],

    // 特权应用白名单文件
    privapp_allowlist: "com.autopilot.xml",

    optimize: {
        enabled: false,
    },

    static_libs: [
        "androidx.annotation_annotation",
    ],
}
