/*
 * AutoPilot — 车载智能终端核心服务
 *
 * 功能：
 * 1. 开机自动启动 WiFi 热点（基于 TetheringManager）
 * 2. 双卡信号智能切换（基于 SubscriptionManager + TelephonyCallback）
 *
 * 作为特权系统应用安装到 /system_ext/priv-app/，
 * 使用 platform 签名以获得系统级权限。
 */
android_app {
    name: "AutoPilot",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    manifest: "AndroidManifest.xml",

    // 使用 platform 签名，获得系统级权限
    platform_apis: true,
    certificate: "platform",

    // 安装到 system_ext 分区的 priv-app 目录
    system_ext_specific: true,
    privileged: true,

    // 替换 LineageOS 开机向导和 AOSP Provision
    // 车载场景无需向导：语言/时区由系统属性预设，AutoPilot 内置 ProvisionActivity
    // 负责静默设置 device_provisioned=1 + user_setup_complete=1，开机直进桌面
    overrides: ["LineageSetupWizard", "Provision"],

    // 特权应用白名单文件
    privapp_allowlist: "com.autopilot.xml",

    optimize: {
        enabled: false,
    },

    static_libs: [
        "androidx.annotation_annotation",
    ],
}
